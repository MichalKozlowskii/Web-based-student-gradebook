# ============================================================
#  .gitignore — Spring Boot Microservices + React + Vite
# ============================================================

# ─── IDE / IntelliJ IDEA ────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
out/
.idea_modules/

# ─── VS Code ────────────────────────────────────────────────
.vscode/
*.code-workspace

# ─── OS ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
#  SPRING BOOT / JAVA
# ============================================================

# Maven
target/
*.jar
*.war
*.ear
*.class
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Gradle (jesli uzywasz)
.gradle/
build/
gradle-app.setting
!gradle-wrapper.jar
.gradletasknamecache

# Spring Boot logs
*.log
logs/
spring.log

**/src/main/resources/application-local.yml
**/src/main/resources/application-local.properties
**/src/main/resources/application-secret*.yml
**/src/main/resources/application-secret*.properties
**/src/main/resources/application-prod.yml
**/src/main/resources/application-prod.properties

# ============================================================
#  FRONTEND — React + Vite
# ============================================================

# Dependencies
frontend/node_modules/
node_modules/

# Build output
frontend/dist/
frontend/dist-ssr/
dist/
dist-ssr/

# Vite cache
frontend/.vite/
.vite/

# Env files
frontend/.env
frontend/.env.local
frontend/.env.*.local
.env
.env.local
.env.*.local

# Logi npm/yarn/pnpm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cache
frontend/.eslintcache
.eslintcache
frontend/.stylelintcache

# TypeScript cache
*.tsbuildinfo
frontend/*.tsbuildinfo

# ============================================================
#  DOCKER
# ============================================================

docker-compose.override.yml
docker-compose.local.yml
.docker/

# ============================================================
#  HELM
# ============================================================

helm/charts/
helm*/charts/
*.tgz

# ============================================================
#  MISC
# ============================================================

*.tmp
*.swp
*.swo
*~

# Certyfikaty / klucze
*.pem
*.key
*.p12
*.jks
*.keystore